{{!
    @template mod_videoprogress/report_student

    Example context (json):
    {
    }
}}

<div class="videoprogress-student-detail">
    <header class="videoprogress-report__header">
        <div>
            <a href="{{backurl}}" class="videoprogress-report__back">{{#str}} backtoreport, videoprogress {{/str}}</a>
            <span class="videoprogress-eyebrow">{{activityname}}</span>
            <h2>{{fullname}}</h2>
            <p>{{email}}</p>
        </div>
        {{#canreset}}
            <a href="{{reseturl}}"
               class="btn btn-outline-danger">{{#str}}resetprogress, videoprogress {{/str}}</a>
        {{/canreset}}
    </header>
    <section class="videoprogress-detail-metrics">
        <article><strong>{{percent}}%</strong><span>{{#str}} progress, videoprogress {{/str}}</span></article>
        <article><strong>{{uniquewatched}}</strong><span>{{#str}} uniquewatched, videoprogress {{/str}}</span></article>
        <article><strong>{{totalwatchtime}}</strong><span>{{#str}} totalwatchtime, videoprogress {{/str}}</span>
        </article>
        <article><strong>{{lastposition}}</strong><span>{{#str}} lastposition, videoprogress {{/str}}</span></article>
        <article><strong>{{status}}</strong><span>{{#str}} status, videoprogress {{/str}}</span></article>
        <article><strong>{{lastview}}</strong><span>{{#str}} lastview, videoprogress {{/str}}</span></article>
    </section>
    <section class="videoprogress-report-timeline">
        <h3>{{#str}} individualtimeline, videoprogress {{/str}}</h3>
        <div class="videoprogress-timeline" role="img"
             aria-label="{{#str}} individualtimelinearia, videoprogress, {{{fullname}}} {{/str}}">
            {{#timeline}}<span class="videoprogress-timeline__bucket level-{{level}}" tabindex="0"
                               title="{{tooltip}}"></span>{{/timeline}}
        </div>
        <p class="sr-only">{{timelinealternative}}</p>
    </section>
    {{#hasobjectives}}
        <section class="videoprogress-detail-section"><h3>{{#str}} learningobjectives, videoprogress {{/str}}</h3>
            <ul>{{#objectives}}
                <li>{{{html}}}</li>{{/objectives}}</ul>
        </section>
    {{/hasobjectives}}
    <section class="videoprogress-detail-section">
        <h3>{{#str}} confirmationtitle, videoprogress {{/str}}</h3>
        {{#confirmation}}
            <p class="text-success">{{#str}}confirmationdetail, videoprogress, {{{confirmationtime}}} {{/str}}</p>
        {{/confirmation}}
        {{^confirmation}}
            <p>{{#str}} notconfirmed, videoprogress {{/str}}</p>
        {{/confirmation}}
    </section>
    <section class="videoprogress-detail-section">
        <h3>{{#str}} sessions, videoprogress {{/str}}</h3>
        {{#hassessions}}
            <div class="videoprogress-sessions">
                {{#sessions}}
                    <article>
                        <strong>{{date}}</strong>
                        <span>{{#str}}sessionduration, videoprogress, {{{duration}}} {{/str}}</span>
                        <span>{{#str}}sessionwatchtime, videoprogress, {{{watchtime}}} {{/str}}</span>
                        <span>{{range}}</span>
                    </article>
                {{/sessions}}
            </div>
        {{/hassessions}}
        {{^hassessions}}<p>{{#str}} nosessions, videoprogress {{/str}}</p>{{/hassessions}}
    </section>
</div>
