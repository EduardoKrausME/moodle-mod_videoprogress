{{!
    @template mod_videoprogress/index

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}

<div class="videoprogress-index">
    <span class="videoprogress-eyebrow">{{coursename}}</span>
    <h2>{{#str}} modulenameplural, videoprogress {{/str}}</h2>
    {{#hasactivities}}
        <div class="videoprogress-index__list">
            {{#activities}}
                <article>
                    <div><h3><a href="{{viewurl}}">{{name}}</a></h3>
                        <p>{{#str}} indexrequirement, videoprogress, completionpercent {{/str}}</p></div>{{#canreport}}
                    <a href="{{reporturl}}" class="btn btn-outline-primary">{{#str}}
                        viewreport, videoprogress {{/str}}</a>{{/canreport}}</article>{{/activities}}
        </div>
    {{/hasactivities}}
    {{^hasactivities}}<p>{{#str}} noactivities, videoprogress {{/str}}</p>{{/hasactivities}}
</div>
