{{!
    @template mod_videoprogress/support_materials

    Example context (json):
    {
        "materials": [
            {
                "html": "<article class=\"videoprogress-material-card\"><strong>Guia de estudo</strong></article>"
            }
        ]
    }
}}

<section class="videoprogress-support-materials" aria-labelledby="videoprogress-materials-heading">
    <div class="videoprogress-section-heading">
        <h3 id="videoprogress-materials-heading">{{#str}} supportmaterials, videoprogress {{/str}}</h3>
        <p>{{#str}} supportmaterialshelp, videoprogress {{/str}}</p>
    </div>
    <div class="videoprogress-support-materials__grid">
        {{#materials}}{{{html}}}{{/materials}}
    </div>
</section>
