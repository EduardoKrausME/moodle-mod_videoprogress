{{!
    @template mod_videoprogress/report_summary

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}

<section class="videoprogress-summary" aria-labelledby="videoprogress-summary-heading">
    <h3 id="videoprogress-summary-heading" class="sr-only">{{#str}} analyticssummary, videoprogress {{/str}}</h3>
    <div class="videoprogress-summary__grid">
        <article class="videoprogress-stat-card"><strong>{{summary.enrolled}}</strong><span>{{#str}}
            enrolledstudents, videoprogress {{/str}}</span></article>
        <article class="videoprogress-stat-card"><strong>{{summary.started}}</strong><span>{{#str}}
            startedstudents, videoprogress {{/str}}</span></article>
        <article class="videoprogress-stat-card"><strong>{{summary.neverstarted}}</strong><span>{{#str}}
            neverstartedstudents, videoprogress {{/str}}</span></article>
        <article class="videoprogress-stat-card"><strong>{{summary.inprogress}}</strong><span>{{#str}}
            inprogressstudents, videoprogress {{/str}}</span></article>
        <article class="videoprogress-stat-card is-accent"><strong>{{summary.completed}}</strong><span>{{#str}}
            completedstudents, videoprogress {{/str}}</span></article>
        <article class="videoprogress-stat-card"><strong>{{summary.averagepercent}}%</strong><span>{{#str}}
            averagewatched, videoprogress {{/str}}</span></article>
        <article class="videoprogress-stat-card"><strong>{{summary.averageunique}}</strong><span>{{#str}}
            averageunique, videoprogress {{/str}}</span></article>
        <article class="videoprogress-stat-card"><strong>{{summary.averagetotal}}</strong><span>{{#str}}
            averagetotal, videoprogress {{/str}}</span></article>
        <article class="videoprogress-stat-card"><strong>{{summary.totalwatchtime}}</strong><span>{{#str}}
            classtotalwatchtime, videoprogress {{/str}}</span></article>
        <article class="videoprogress-stat-card is-accent"><strong>{{summary.completionrate}}%</strong><span>{{#str}}
            completionrate, videoprogress {{/str}}</span></article>
    </div>
</section>
