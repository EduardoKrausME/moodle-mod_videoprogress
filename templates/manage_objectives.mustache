{{!
    @template mod_videoprogress/manage_objectives

    Example context (json):
    {
        "activityname": "Composição visual",
        "backurl": "/mod/videoprogress/view.php?id=10",
        "hasplugins": true,
        "addurls": [{"name": "Texto", "url": "/mod/videoprogress/objective/edit.php?id=10&plugin=text"}],
        "hasitems": true,
        "items": [{
            "summary": "Identificar elementos visuais",
            "pluginname": "Texto",
            "disabled": false,
            "pluginavailable": true,
            "editurl": "/edit",
            "deleteurl": "/delete"
        }]
    }
}}
<div class="videoprogress-manage">
    <a href="{{backurl}}" class="videoprogress-report__back">{{#str}} backtovideo, videoprogress {{/str}}</a>
    <span class="videoprogress-eyebrow">{{activityname}}</span>
    <div class="videoprogress-manage__heading">
        <div>
            <h2>{{#str}} manageobjectives, videoprogress {{/str}}</h2>
            <p>{{#str}} manageobjectiveshelp, videoprogress {{/str}}</p>
        </div>
        {{#hasplugins}}
            <div class="dropdown">
                <button class="btn btn-primary dropdown-toggle" type="button" data-toggle="dropdown">
                    {{#str}} addobjective, videoprogress {{/str}}
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    {{#addurls}}<a class="dropdown-item" href="{{url}}">{{name}}</a>{{/addurls}}
                </div>
            </div>
        {{/hasplugins}}
    </div>
    {{#hasitems}}
        <div class="videoprogress-manage-list">
            {{#items}}
                <article>
                    <div>
                        <strong>{{summary}}</strong>
                        <span>{{pluginname}}</span>
                        {{#disabled}}<span class="badge badge-secondary">{{#str}}
                            disabled, videoprogress {{/str}}</span>{{/disabled}}
                    </div>
                    <div>
                        {{#pluginavailable}}<a class="btn btn-sm btn-outline-primary" href="{{editurl}}">{{#str}}
                            edit, videoprogress {{/str}}</a>{{/pluginavailable}}
                        <a class="btn btn-sm btn-outline-danger" href="{{deleteurl}}">{{#str}}
                            delete, videoprogress {{/str}}</a>
                    </div>
                </article>
            {{/items}}
        </div>
    {{/hasitems}}
    {{^hasitems}}
        <div class="videoprogress-empty">
            <h3>{{#str}} noobjectives, videoprogress {{/str}}</h3>
            <p>{{#str}} noobjectiveshelp, videoprogress {{/str}}</p>
        </div>
    {{/hasitems}}
    {{^hasplugins}}
        <div class="alert alert-warning">{{#str}} noobjectiveplugins, videoprogress {{/str}}</div>
    {{/hasplugins}}
</div>
